# Entorno virtual
.venv/
venv/

# Python
__pycache__/
*.pyc

# Jupyter: se versiona solo el .py emparejado con jupytext
# (el .ipynb es la copia local de cada integrante, con sus salidas)
.ipynb_checkpoints/
*/notebooks/*.ipynb

# Resultados guardados de los cálculos que tardan varios minutos (búsquedas de hiperparámetros
# y predicciones); cada notebook los genera la primera vez que se ejecuta
*/data/*.pkl

# Sistema operativo / editores
.DS_Store
Thumbs.db
.vscode/
.idea/
